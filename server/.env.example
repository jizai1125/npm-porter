PORT=3000
DATA_DIR=
DEFAULT_UPSTREAM_REGISTRY=https://registry.npmjs.org
MAX_UPLOAD_MB=512

# 是否开启登录保护
AUTH_ENABLED=false

# 开启登录后可配置的登录方式；两者都配时，登录页同时显示两种入口
AUTH_PASSWORD=
AUTH_VERDACCIO_URL=http://127.0.0.1:4873

# 可选：Cookie 签名密钥；不设置时每次重启后旧会话失效
AUTH_SESSION_SECRET=

# HTTPS 部署时建议改为 true
AUTH_COOKIE_SECURE=false
