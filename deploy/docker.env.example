# 复制为项目根目录 .env 后按需修改：cp deploy/docker.env.example .env

# 后端监听端口（容器内固定为 3000，通常无需修改）
PORT=3000

# 数据持久化目录（容器内路径，挂载到 docker volume）
DATA_DIR=/data

# 外网导出侧使用的默认上游 registry
DEFAULT_UPSTREAM_REGISTRY=https://registry.npmjs.org

# 登录保护
AUTH_ENABLED=true
AUTH_PASSWORD=
AUTH_VERDACCIO_URL=http://verdaccio:4873
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=false

# nginx 暴露到宿主机的端口
HTTP_PORT=8080

# 使用 --profile verdaccio 启动内置 Verdaccio 时暴露的端口
VERDACCIO_PORT=4873
